# Copy to .env, protect it (chmod 600), and replace placeholders.
# Private VPN access and external HTTPS termination are required; no app login exists.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/feedrafter
APP_ORIGIN=https://feedrafter.example.internal
# Existing host directory, writable by UID/GID 1000; restrict access and set a host quota.
APP_DATA_DIR=/absolute/path/to/private/feedrafter-data
# Optional FreshRSS configuration is intentionally not passed by compose.yaml.
# See docs/operations.md before enabling; read acknowledgements remain disabled.
