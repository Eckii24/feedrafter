# Local Compose only. Copy to .env.local and generate a unique password as in README.
# LOCAL_DB_PASSWORD must be URL-safe (use the hex generator in README).
# LOCAL_DB_PASSWORD=
# LOCAL_APP_PORT=3000
# Optional, only after reading the local processing prerequisites in README:
# LOCAL_PROCESSING_ENABLED=true
# LOCAL_EXCLUSIVE_DB_ACK=true
# LOCAL_UNVERIFIED_SIZING_ACK=true
# LOCAL_CODEX_COST_ACK=true
# LOCAL_CLASSIFIER_DAILY=20
# LOCAL_CLASSIFIER_CONCURRENCY=1
# LOCAL_AUTOMATIC_DAILY=10
# LOCAL_AUTOMATIC_CONCURRENCY=1
